# 环境变量模板：复制本文件为 .env 并按需修改（.env 已加入 .gitignore，不会提交真实密码）
# cp .env.example .env    (Windows PowerShell: Copy-Item .env.example .env)

# MySQL root 密码（容器内初始化使用）
MYSQL_ROOT_PASSWORD=gym123456

# 初始化的数据库名
MYSQL_DATABASE=gym

# 应用连接数据库使用的账号
MYSQL_USERNAME=root

# 宿主机 MySQL 容器端口映射（宿主机 3306 已被本地 MySQL 占用，故用 3307）
MYSQL_HOST_PORT=3307

# 应用对外端口
APP_PORT=8080

# 微服务专用 MySQL 实例的宿主机端口映射（第 06 周，独立于单体版 3307）
MYSQL_MS_HOST_PORT=3308

# ========== Nacos 注册中心（第 07 周） ==========
# 控制台 http://localhost:18080（占位端口，可自行修改避免冲突）
NACOS_CONSOLE_HOST_PORT=18080
# 服务端 API 端口
NACOS_SERVER_HOST_PORT=8848
# 是否开启鉴权（课堂要求开启）
NACOS_AUTH_ENABLE=true
# JWT Token 密钥：必须是 Base64 编码且原文长度 >= 32 字节（请改成自己的值，不要提交真实值）
NACOS_AUTH_TOKEN=<替换为你的Base64密钥，例如：SecretKey0123456789012345678901234567890123456789>
# Server identity（服务端间请求的身份钥匙，请改成自己的值）
NACOS_AUTH_IDENTITY_KEY=<替换为身份钥匙名>
NACOS_AUTH_IDENTITY_VALUE=<替换为身份钥匙值>
# 管理员账号与首次初始化密码（请改成自己的值，不要提交真实值）
NACOS_USERNAME=nacos
NACOS_PASSWORD=<替换为你的管理员密码>
# 个人项目独立分组（与课堂示例隔离）
NACOS_GROUP=GYM_YZ_GROUP
