# 环境变量模板：复制本文件为 .env 并按需修改（.env 已加入 .gitignore，不会提交真实密码）
# cp .env.example .env    (Windows PowerShell: Copy-Item .env.example .env)

# MySQL root 密码（容器内初始化使用）
MYSQL_ROOT_PASSWORD=gym123456

# 初始化的数据库名
MYSQL_DATABASE=gym

# 应用连接数据库使用的账号
MYSQL_USERNAME=root

# 宿主机 MySQL 容器端口映射（宿主机 3306 已被本地 MySQL 占用，故用 3307）
MYSQL_HOST_PORT=3307

# 应用对外端口
APP_PORT=8080
